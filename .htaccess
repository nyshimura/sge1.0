# .htaccess for Root Directory

# Enable Rewrite Engine
RewriteEngine On
RewriteBase /

# Prevent Directory Listing
Options -Indexes

# Security: Deny access to sensitive files
<FilesMatch "\.(sql|log|bak|ini|sh|env|md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "(composer\.json|package\.json|metadata\.json|tsconfig\.json)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Serve index.html for non-existent files (SPA fallback if needed)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
